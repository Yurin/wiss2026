# Copy to .env. Keep this file out of public/static directories.
HOST=127.0.0.1
PORT=3101
WISS_PUBLIC_URL=https://configure-server.invalid
# Absolute path outside the document root; do not share between the two servers.
# WISS_DATA_DIR=/srv/wiss-production/WISS-Pair-data
WISS_OPERATOR_TOKEN=
WISS_WORKER_TOKEN=
IMMICH_ENABLED=false
IMMICH_DELIVERY_MODE=hold
IMMICH_API_URL=
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
IMMICH_TIMEOUT_MS=30000
IMMICH_MAX_ATTEMPTS=5
WISS_WORKER_LEASE_MS=300000
WISS_RETENTION_MS=604800000
WISS_DRAFT_TTL_MS=3600000
WISS_STORAGE_LIMIT_BYTES=2147483648
# Set only after the organizer confirms audience, retention, and inquiry contact.
WISS_SHARE_CONSENT_TEXT=
WISS_SHARE_CONSENT_VERSION=
WISS_PYTHON=python3
